# AgentDesk AI — environment template. Copy to .env. Never commit real secrets.

# --- General ---
APP_NAME=AgentDesk AI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Postgres (used by docker-compose for the db service) ---
POSTGRES_USER=agentdesk
POSTGRES_PASSWORD=agentdesk
POSTGRES_DB=agentdesk

# --- Backend connections ---
# In docker-compose use host "db"/"redis"; locally use "localhost".
DATABASE_URL=postgresql+asyncpg://agentdesk:agentdesk@db:5432/agentdesk
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- LLM / embedding providers (mock keeps everything offline & deterministic) ---
LLM_PROVIDER=mock          # mock | anthropic | openai
EMBEDDING_PROVIDER=mock    # mock | anthropic | openai
EMBEDDING_DIM=384
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent workflow thresholds ---
CONFIDENCE_THRESHOLD=0.7
SIMILARITY_THRESHOLD=0.5
RETRIEVAL_TOP_K=5

# --- Webhooks ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BACKOFF_BASE_SECONDS=2.0
WEBHOOK_TIMEOUT_SECONDS=10.0

# --- Security / HTTP ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
